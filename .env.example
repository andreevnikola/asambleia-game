# Neon: direct (unpooled) connection — used only by `pnpm db:migrate`
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Neon: pooled connection (host contains "-pooler") — used by the app at runtime
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Secret entered on /admin
ADMIN_SECRET="change-me"

# Optional SSE tuning for the leaders' live feed (defaults shown).
# Without Fluid compute Vercel Hobby cuts functions at 60 s: then set SSE_MAX_MS=50000.
# SSE_POLL_MS=2000
# SSE_MAX_MS=240000
